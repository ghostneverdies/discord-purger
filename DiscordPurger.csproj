<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DiscordPurger</RootNamespace>
    <AssemblyName>DiscordPurger</AssemblyName>
    <ApplicationIcon>assets\icon.ico</ApplicationIcon>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3179.45" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="web\**\*" Exclude="web\**\*.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="assets\icon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>